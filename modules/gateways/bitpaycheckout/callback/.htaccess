# Block direct access to log or text files in this directory.
# The IPN script itself must stay reachable, so only these extensions are denied.
<FilesMatch "\.(txt|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
